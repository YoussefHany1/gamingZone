{
  "projectId": "$APPWRITE_PROJECT_ID",
  "endpoint": "$APPWRITE_ENDPOINT",
  "functions": [
    {
      "$id": "cron",
      "name": "Game Jobs Cron",
      "runtime": "node-20.0",
      "path": "apps/backend/functions/cron",
      "entrypoint": "dist/main.js",
      "commands": "npm install && npm run build",
      "timeout": 900,
      "logging": true,
      "enabled": true,
      "execute": [],
      "schedule": "*/5 * * * *",
      "events": []
    }
  ]
}