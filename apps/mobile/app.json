{
  "expo": {
    "name": "Gaming Zone",
    "slug": "gaming-zone",
    "orientation": "default",
    "scheme": "gaming-zone",
    "version": "1.0.8",
    "icon": "./assets/logo-background.png",
    "userInterfaceStyle": "light",
    "android": {
      "versionCode": 46,
      "runtimeVersion": "1.0.8",
      "userInterfaceStyle": "light",
      "package": "com.yh.gamingzone",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0c1a33"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "gz1.games",
              "pathPrefix": "/news"
            },
            {
              "scheme": "https",
              "host": "gz1.games",
              "pathPrefix": "/lists"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": false
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "expo-localization",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0c1a33"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-background.png",
          "resizeMode": "cover",
          "backgroundColor": "#0c1a33"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      ["@react-native-community/datetimepicker", {}],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4635812020796700~2053599689",
          "iosAppId": "ca-app-pub-4635812020796700~1466759291",
          "delayAppMeasurementInit": false
        }
      ],
      "./plugins/withR8Optimization"
    ],
    "updates": {
      "url": "https://u.expo.dev/25078fb9-8a54-4056-b988-2ac45be30e52"
    },
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "associatedDomains": ["applinks:gz1.games"]
    }
  }
}
