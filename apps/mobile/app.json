{
  "expo": {
    "name": "Gaming Zone",
    "slug": "gaming-zone",
    "orientation": "default",
    "scheme": "gaming-zone",
    "version": "1.0.4",
    "icon": "./assets/logo-background.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/logo-background.png",
      "resizeMode": "cover",
      "backgroundColor": "#0c1a33"
    },
    "android": {
      "resizeableActivity": true,
      "versionCode": 44,
      "runtimeVersion": "1.0.4",
      "userInterfaceStyle": "light",
      "package": "com.yh.gamingzone",
      "jsEngine": "hermes",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-4635812020796700~2053599689"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0c1a33"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "gz1.vercel.app",
              "pathPrefix": "/news"
            },
            {
              "scheme": "https",
              "host": "gz1.vercel.app",
              "pathPrefix": "/lists"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#0c1a33",
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notifications} new interactions"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-video",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4635812020796700~2053599689",
          "iosAppId": "ca-app-pub-4635812020796700~1466759291",
          "delayAppMeasurementInit": false
        }
      ]
    ],
    "react-native-google-mobile-ads": {
      "android_app_id": "ca-app-pub-4635812020796700~2053599689"
    },
    "updates": {
      "url": "https://u.expo.dev/25078fb9-8a54-4056-b988-2ac45be30e52"
    },
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "associatedDomains": ["applinks:gz1.vercel.app"]
    }
  }
}
