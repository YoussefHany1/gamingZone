    "firebase-admin": "^13.6.0",
    "got-scraping": "^4.1.2",
    "jsdom": "^29.1.1",
    "node-appwrite": "^21.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tough-cookie": "^6.0.0"
  }
}