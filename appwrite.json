      "entrypoint": "dist/main.js",
      "commands": "npm install && npm run build",
      "timeout": 900,
      "logging": true,
      "enabled": true,
      "execute": [],
      "schedule": "0 * * * *",
      "events": []
    },
    {
      "$id": "weekly-summary",
      "name": "Weekly Summary Generator",
      "runtime": "node-20.0",
      "path": "apps/backend/functions/weekly-summary",
      "entrypoint": "dist/main.js",
      "commands": "npm install && npm run build",
      "timeout": 900,
      "logging": true,
