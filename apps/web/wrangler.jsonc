{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gamingzone-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Required by OpenNext for ISR revalidation requests.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gamingzone-web",
    },
  ],
  "r2_buckets": [
    {
      // Create before deploying: npx wrangler r2 bucket create gamingzone-web-opennext-cache
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "gamingzone-web-opennext-cache",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "gz1.games",
      "custom_domain": true,
    },
    {
      "pattern": "www.gz1.games",
      "custom_domain": true,
    },
  ],
}
