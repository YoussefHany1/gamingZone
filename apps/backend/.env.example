RSS_SECRET="your_rss_secret_here"
FIREBASE_PROJECT_ID="your_firebase_project_id"
SERVICE_ACCOUNT=./serviceAccountKey.json

APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT=your_appwrite_project_id
APPWRITE_API_KEY=your_appwrite_api_key
APPWRITE_DATABASE_ID=your_appwrite_database_id

GEMINI_API_KEY=your_gemini_api_key

# Groq — optional fallback for Gemini in the AI summary jobs.
# GROQ_MODEL must be a generative model available to your key (classifier-only
# models like meta-llama/llama-prompt-guard-2-* cannot generate summaries).
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Groq model(s) in fallback order. GROQ_MODELS takes precedence over
# GROQ_MODEL and both accept a comma-separated list (only the first slash
# splits, because Groq ids contain slashes). Must be generative models —
# classifier-only ones (meta-llama/llama-prompt-guard-2-*) cannot produce
# summaries. Default: openai/gpt-oss-120b,openai/gpt-oss-20b.
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Cerebras Cloud - optional final AI fallback (OpenAI-compatible chat completions,
# JSON mode; generative models only).
# CEREBRAS_API_KEY=your_cerebras_api_key
# CEREBRAS_MODELS=gpt-oss-120b,qwen-3.8-27b

# Force a single provider for smoke tests: gemini | groq
# AI_PROVIDER=groq

# Model fallback chain for AI jobs (summary:weekly, summary:articles, ...).
# Comma-separated, tried in order. A bare id is a Gemini model; "<provider>/<model>"
# picks another provider — only the FIRST slash splits, because Groq model ids
# themselves contain slashes. Check available models with: npm run ai:models
# Default (used when unset):
# AI_CHAIN=gemini/gemini-2.5-flash,gemini/gemini-3.1-flash-lite,groq/openai/gpt-oss-120b,groq/openai/gpt-oss-20b

# Database Collections
RSS_COLLECTION_ID=news_sources
ARTICLES_COLLECTION_ID=articles
COLLECTION_FREE_GAMES=free_games
SUMMARIES_COLLECTION_ID=weekly_summaries

# Firebase Cloud Messaging Service Account (Minified JSON)
FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_firebase_project_id","private_key_id":"your_private_key_id","private_key":"-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n","client_email":"your_client_email@your_project.iam.gserviceaccount.com","client_id":"your_client_id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"your_cert_url","universe_domain":"googleapis.com"}

# IGDB
TWITCH_CLIENT_ID="your_twitch_client_id"
TWITCH_CLIENT_SECRET="your_twitch_client_secret"
PORT=3000

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_UPLOAD_PRESET="Gaming Zone"

# Google Auth
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Steam
STEAM_API_KEY=your_steam_api_key

# Discord sign-in
# 1. https://discord.com/developers/applications → New Application
# 2. OAuth2 → Redirects → add DISCORD_REDIRECT_URI *exactly*
# 3. OAuth2 → copy the Client ID and reset/copy the Client Secret
# Discord has no Firebase provider, so the backend mints a Firebase custom token.
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://api-fallback.vercel.app/auth/discord/callback